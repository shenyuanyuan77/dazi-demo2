<!--
  广场首页 — iOS 26 / Liquid Glass 风格重构
  文件: default_index.wxml
-->

<block wx:if="{{!isLoad}}">
  <view class="skeleton-page"><view class="skeleton skeleton-header"></view><view class="skeleton skeleton-banner"></view><view class="skeleton skeleton-card"></view></view>
</block>

<block wx:else>

  <view class="glass-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="glass-nav-inner">
      <view class="nav-top flex-between">
        <view class="nav-user" catchtap="url" data-url="../../my/index/my_index">
          <view class="nav-avatar"><image src="{{userAvatar || '/projects/dazi/images/tabbar/my.png'}}" mode="aspectFill" class="avatar-img" /></view>
          <view class="nav-text"><view class="nav-greeting">{{greeting}} 👋</view><view class="nav-username">{{userName || '健身搭子'}}</view></view>
        </view>
        <view class="nav-ai-btn" catchtap="openAi"><text class="ai-badge">AI</text><text class="ai-label">健身助手</text></view>
      </view>
      <view class="nav-search"><view class="search-bar glass-light"><text class="search-icon">🔍</text><input class="search-input" placeholder="搜索健身活动、伙伴..." placeholder-class="search-placeholder" value="{{searchValue}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" /></view></view>
      <scroll-view class="cate-scroll" scroll-x show-scrollbar="{{false}}" enable-flex>
        <view class="cate-chip {{currentCate === index ? 'active' : ''}}" wx:for="{{cateMenus}}" wx:key="index" data-index="{{index}}" catchtap="onCateChange"><text>{{item.label}}</text></view>
      </scroll-view>
    </view>
  </view>

  <view class="page-content page-has-glass-nav" catchtouchend="onLoadMore">
    <view class="content-top-spacer"></view>
    <view class="banner-card glass-card">
      <view class="banner-bg"><image src="/projects/dazi/images/banner.jpg" mode="scaleToFill" class="banner-img" lazy-load /></view>
      <view class="banner-overlay"><view class="banner-title">找到你的运动搭子</view><view class="banner-subtitle">一起流汗，一起变强</view></view>
    </view>

    <view class="ai-card glass-card" style="background: linear-gradient(135deg, #1a1d21 0%, #2a2d33 100%);">
      <view class="ai-card-head flex-between" catchtap="toggleAiCard">
        <view class="flex-row gap-sm"><view class="ai-card-icon">AI</view><view><view class="ai-card-title">AI 健身助手</view><view class="ai-card-subtitle">饮食测算 · 训练计划</view></view></view>
        <view class="ai-card-toggle" catchtap="toggleAiCard"><text>{{aiExpanded ? '收起' : '展开'}}</text></view>
      </view>
      <view wx:if="{{aiExpanded}}" class="ai-card-body">
        <view wx:if="{{!aiResults.length}}" class="ai-empty" catchtap="openAi">
          <view class="ai-empty-icon">AI</view>
          <view class="ai-empty-text"><view class="ai-empty-title">还没有 AI 方案</view><view class="ai-empty-desc">描述一顿饭，或告诉我你的训练目标</view></view>
          <view class="ai-empty-arrow">→</view>
        </view>
        <scroll-view wx:else scroll-x class="ai-results-scroll" show-scrollbar="{{false}}">
          <view class="ai-results-row flex-row gap-md">
            <view class="ai-result-card {{result.AI_RESULT_TYPE}}" wx:for="{{aiResults}}" wx:for-item="result" wx:key="AI_RESULT_ID">
              <view class="ai-result-header flex-between"><text class="ai-result-type">{{result.AI_RESULT_TYPE === 'diet' ? '饮食' : '训练'}}</text><view class="ai-result-refresh" catchtap="refreshAiResult" data-id="{{result.AI_RESULT_ID}}">↻</view></view>
              <view class="ai-result-title text-ellipsis">{{result.AI_RESULT_TITLE}}</view>
              <view wx:if="{{result.AI_RESULT_TYPE === 'diet'}}" class="ai-diet-data">
                <view class="ai-calories"><text>{{result.AI_RESULT_PAYLOAD.calories || '--'}}</text> kcal</view>
                <view class="ai-macros"><text class="macro-item">P {{result.AI_RESULT_PAYLOAD.protein || '--'}}g</text><text class="macro-item">C {{result.AI_RESULT_PAYLOAD.carbs || '--'}}g</text><text class="macro-item">F {{result.AI_RESULT_PAYLOAD.fat || '--'}}g</text></view>
              </view>
              <view wx:else class="ai-training-preview">{{result.AI_RESULT_PAYLOAD.days && result.AI_RESULT_PAYLOAD.days[0] ? result.AI_RESULT_PAYLOAD.days[0].name : '个性训练安排'}}</view>
              <view class="ai-result-summary">{{result.AI_RESULT_SUMMARY}}</view>
              <view class="ai-result-link" catchtap="openAi" data-session="{{result.AI_RESULT_SESSION_ID}}">继续追问 →</view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="activity-section">
      <view class="section-header flex-between"><view class="section-title-wrap"><text class="section-title">推荐活动</text><text class="section-subtitle">{{dataList.total || 0}} 个活动</text></view></view>
      <view wx:if="{{dataList.list && dataList.list.length}}" class="activity-list">
        <view class="activity-card glass-card" wx:for="{{dataList.list}}" wx:for-item="item" wx:key="_id" catchtap="goActivityDetail" data-id="{{item._id}}">
          <view class="card-cover-wrap">
            <image src="{{item.ACTIVITY_OBJ && item.ACTIVITY_OBJ.cover || ''}}" mode="aspectFill" class="card-cover" lazy-load />
            <view class="card-cate-badge">{{item.ACTIVITY_CATE_NAME || ''}}</view>
            <view class="card-date-badge">{{item.ACTIVITY_START_DAY || ''}}</view>
            <view class="card-join-badge"><text class="join-count">{{item.ACTIVITY_JOIN_CNT || 0}}</text><text class="join-label">人报名</text></view>
          </view>
          <view class="card-body">
            <view class="card-title text-ellipsis-2">{{item.ACTIVITY_TITLE}}</view>
            <view class="card-meta">
              <view class="card-publisher flex-row gap-sm"><image class="publisher-avatar" src="{{item.user && item.user.USER_PIC || ''}}" mode="aspectFill" lazy-load /><text class="publisher-name">{{item.user && item.user.USER_NAME || '平台发布'}}</text></view>
              <view class="card-location flex-row gap-xs"><text class="location-icon">📍</text><text class="location-text text-ellipsis">{{item.ACTIVITY_ADDRESS || '待定'}}</text></view>
              <view class="card-time flex-row gap-xs" wx:if="{{item.ACTIVITY_START_TIME}}"><text class="time-icon">🕐</text><text class="time-text">{{item.ACTIVITY_START_TIME}}</text></view>
            </view>
          </view>
        </view>
        <view class="load-more">
          <view wx:if="{{loadingMore}}" class="loading-spinner"><view class="spinner"></view><text>加载中...</text></view>
          <view wx:elif="{{!hasMore && dataList.list.length > 0}}" class="no-more"><view class="no-more-line"></view><text>没有更多了</text><view class="no-more-line"></view></view>
        </view>
      </view>
      <empty-state icon="🏋️" title="暂无推荐活动" desc="去发布第一个活动，找到你的运动搭子" btnText="发布活动" showBtn="{{true}}" bind:action="goPublish" wx:else />
    </view>

    <view class="bottom-safe-spacer"></view>
  </view>

  <view class="float-publish-btn" catchtap="goPublish"><text class="publish-icon">+</text><text class="publish-text">发布</text></view>
  <view wx:if="{{aiEntryMode === 'float' || aiEntryMode === 'both'}}" class="float-ai-entry" catchtap="openAi"><text class="float-ai-badge">AI</text></view>

  <floating-tabbar current="{{currentTab}}" bind:tabtap="onTabTap" />

</block>
