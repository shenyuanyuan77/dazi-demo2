# ============ LLM Provider (MiMo 优先, OpenAI 兼容) ============
# 默认走小米 MiMo, 因为其 OpenAI 兼容, 1 行 base_url 切换即可换到 DeepSeek/Qwen/OpenAI.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_FAST_MODEL=mimo-v2-flash
MIMO_TIMEOUT_SECONDS=60

# ============ HTTP Server ============
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_LOG_LEVEL=INFO

# ============ RAGFlow (M3 启用; M1/M2 可留空, retriever 节点会优雅降级到内置知识) ============
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_KB_DIET=
RAGFLOW_KB_TRAINING=
RAGFLOW_KB_FAQ=
RAGFLOW_SCORE_THRESHOLD=0.35
RAGFLOW_TOP_K=5
RAGFLOW_TIMEOUT_SECONDS=15

# ============ Service mesh ============
# 校验调用方签名 (云函数转发时附带, 防止直接被外部调)
AGENT_INTERNAL_TOKEN=
