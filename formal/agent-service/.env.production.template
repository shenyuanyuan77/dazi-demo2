# ============================================================
# agent-service 生产环境变量 (.env.production)
# 复制为 .env 后填写真实值, 禁止入仓.
# ============================================================

# ---------- LLM (必填) ----------
MIMO_API_KEY=mi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_FAST_MODEL=mimo-v2-flash
MIMO_TIMEOUT_SECONDS=60

# ---------- HTTP ----------
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_LOG_LEVEL=INFO

# ---------- RAGFlow (选填, 不填则用 local TF-IDF) ----------
# RAGFLOW_BASE_URL=https://your-ragflow-host
# RAGFLOW_API_KEY=rf-xxxxxxxx
# RAGFLOW_KB_DIET=
# RAGFLOW_KB_TRAINING=
# RAGFLOW_KB_FAQ=
# RAGFLOW_SCORE_THRESHOLD=0.35
# RAGFLOW_TOP_K=5
# RAGFLOW_TIMEOUT_SECONDS=15

# ---------- 服务网格 (必填, 与 mcloud 云函数 AGENT_INTERNAL_TOKEN 一致) ----------
AGENT_INTERNAL_TOKEN=生成一个随机32位字符串填这里
