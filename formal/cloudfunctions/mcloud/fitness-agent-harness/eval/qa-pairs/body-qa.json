[
  {
    "id": "qa-body-001",
    "category": "body_analysis",
    "question": "我 165，115 斤，帮我分析一下",
    "expectedAnswer": "把 115 斤换算为 57.5 kg，生成身体数据待确认项。",
    "initialState": { "userProfile": { "goal": "减脂" } },
    "expect": {
      "intent": "BODY_ANALYSIS",
      "pendingWrite": { "type": "body_metric", "target": "bodyMetrics", "needUserConfirm": true },
      "mustAskConfirmation": true,
      "mustNotWriteDb": true,
      "slotsShouldContain": { "heightCm": 165, "weightJin": 115, "weightKg": 57.5 },
      "answerMustContain": ["57.5", "确认"]
    }
  },
  {
