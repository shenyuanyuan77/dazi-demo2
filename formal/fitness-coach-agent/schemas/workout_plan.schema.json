{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workout Plan Payload",
  "type": "object",
  "required": ["exercises"],
  "properties": {
    "date": { "type": "string" },
    "writeMode": { "enum": ["", "append", "replace", "week", "template"] },
    "focus": { "type": "string" },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sets"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "weight": { "type": "string" },
                "reps": { "type": "string" },
                "duration": { "type": "string" },
                "restSeconds": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
