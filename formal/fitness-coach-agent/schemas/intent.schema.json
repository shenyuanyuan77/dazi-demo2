{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fitness Coach Intent",
  "type": "object",
  "required": ["intent", "domain", "responseMode"],
  "properties": {
    "intent": {
      "enum": [
        "diet_image_recognition",
        "diet_text_logging",
        "diet_advice",
        "workout_plan_generate",
        "workout_log_record",
        "body_data_recognition",
        "body_data_update",
        "modify_pending_proposal",
        "health_summary",
        "answer",
        "clarify"
      ]
    },
    "domain": { "enum": ["diet", "training", "body", "general"] },
    "responseMode": { "enum": ["answer_only", "generate_proposal", "modify_proposal", "clarify"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "targetProposalType": { "enum": ["", "dietLog", "workoutPlan", "profilePatch"] }
  }
}
