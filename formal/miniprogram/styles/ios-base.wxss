/* ============================================================
   iOS BASE — iOS 26 / HIG 全局基类
   - .ios-page         页面级背景 + 安全区
   - .ios-nav          自定义胶囊导航容器
   - .ios-nav-title    大标题 (Large Title)
   - .ios-nav-action   导航栏右侧动作按钮
   - .ios-section      Inset Grouped Section
   - .ios-list-row     List Row（含左/中/右三段）
   - .ios-divider      iOS 分隔线
   - .ios-toolbar      底部工具条
   ============================================================ */

.ios-page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-primary);
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ios-page-no-tab {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-primary);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ios-nav {
  position: relative;
  padding: 0 var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}

.ios-nav-title {
  font-size: var(--font-large-title);
  font-weight: 800;
  letter-spacing: -0.4rpx;
  line-height: 1.15;
  color: var(--color-text-primary);
}

.ios-nav-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 64rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  color: var(--color-primary);
  transition: opacity var(--duration-fast) var(--ease-smooth);
}

.ios-nav-action:active {
  opacity: 0.55;
}

.ios-nav-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 64rpx;
  border-radius: var(--radius-full);
  color: var(--color-primary);
  font-size: var(--font-title-3);
  font-weight: 500;
  margin-left: calc(-1 * var(--space-sm));
}

.ios-nav-back:active { opacity: 0.55; }

.ios-nav-large-title-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  padding: var(--space-md) var(--space-lg) var(--space-sm);
}

.ios-nav-large-title {
  font-size: var(--font-large-title);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  color: var(--color-text-primary);
}

.ios-nav-subtitle {
  margin-top: var(--space-2xs);
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

/* Inset Grouped Section 容器 */
.ios-section {
  margin: var(--space-md) var(--space-lg) 0;
  background: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.ios-section-header {
  padding: var(--space-md) var(--space-lg) var(--space-xs);
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.4rpx;
}

.ios-section-footer {
  padding: var(--space-xs) var(--space-lg) var(--space-md);
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

/* List Row */
.ios-list-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--space-lg);
  background: var(--color-card);
  position: relative;
}

.ios-list-row + .ios-list-row::before {
  content: "";
  position: absolute;
  left: var(--space-lg);
  right: 0;
  top: 0;
  height: 0.5rpx;
  background: var(--color-ios-divider-thin);
}

.ios-list-row-leading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-alt);
  color: var(--color-primary);
  flex-shrink: 0;
}

.ios-list-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ios-list-row-title {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.ios-list-row-subtitle {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  line-height: 1.4;
  margin-top: 2rpx;
}

.ios-list-row-trailing {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  margin-left: var(--space-sm);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.ios-list-row-chevron {
  margin-left: var(--space-xs);
  font-size: var(--font-xl);
  color: var(--color-text-tertiary);
  font-weight: 300;
}

/* 分隔线 */
.ios-divider {
  height: 0.5rpx;
  background: var(--color-ios-divider-thin);
  margin: 0 var(--space-lg);
}

.ios-divider-inset {
  height: 0.5rpx;
  background: var(--color-ios-divider-thin);
  margin-left: calc(var(--space-lg) + 56rpx + var(--space-md));
}

/* 底部工具条（Modal 等） */
.ios-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-lg);
  border-top: 0.5rpx solid var(--color-ios-divider-thin);
  background: var(--color-card);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
}

.ios-toolbar-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 140rpx;
  padding: 0 var(--space-xl);
  border-radius: var(--radius-lg);
  font-size: var(--font-md);
  font-weight: 600;
  transition: opacity var(--duration-fast) var(--ease-smooth);
}

.ios-toolbar-button.primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.ios-toolbar-button.secondary {
  background: var(--color-bg-alt);
  color: var(--color-text-primary);
}

.ios-toolbar-button:active { opacity: 0.7; }

/* 大标题文本（用于页面顶部展示） */
.ios-large-title {
  font-size: var(--font-large-title);
  font-weight: 800;
  letter-spacing: -0.6rpx;
  color: var(--color-text-primary);
  padding: var(--space-md) var(--space-lg) var(--space-sm);
  line-height: 1.15;
}

.ios-large-title-subtitle {
  padding: 0 var(--space-lg) var(--space-md);
  font-size: var(--font-callout);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

/* 暗色模式 */
@media (prefers-color-scheme: dark) {
  .ios-section,
  .ios-list-row {
    background: var(--color-card);
    color: var(--color-text-primary);
  }
  .ios-list-row-leading { background: rgba(118, 118, 128, 0.24); }
  .ios-divider,
  .ios-list-row + .ios-list-row::before { background: rgba(255, 255, 255, 0.08); }
}