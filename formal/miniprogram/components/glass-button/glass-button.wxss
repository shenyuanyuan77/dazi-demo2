@import "../../styles/design-tokens.wxss";
/* styles inherited from design-tokens.wxss btn-* classes */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  transition: all var(--duration-fast) var(--ease-smooth);
  gap: 8rpx;
}
.btn-primary {
  height: 88rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  font-size: var(--font-base);
  font-weight: 600;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 79, 0.22);
}
.btn-primary:active { transform: scale(0.96); }
.btn-secondary {
  height: 88rpx;
  padding: 0 48rpx;
  background: transparent;
  border: 2rpx solid var(--color-primary);
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-primary);
}
.btn-glass {
  height: 72rpx;
  padding: 0 36rpx;
  background: rgba(255,255,255,0.7);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255,255,255,0.4);
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--color-text-primary);
  box-shadow: var(--shadow-xs);
}
.btn-sm { height: 56rpx; padding: 0 28rpx; font-size: var(--font-xs); border-radius: var(--radius-lg); }
.btn-lg { height: 96rpx; padding: 0 56rpx; font-size: var(--font-md); }
.btn-disabled { opacity: 0.45; pointer-events: none; }
