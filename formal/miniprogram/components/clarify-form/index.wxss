/* components/clarify-form/index.wxss */
.clarify-card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--space-lg);
  margin: var(--space-md) 0;
  box-shadow: var(--shadow-sm);
  border: 0.5rpx solid var(--color-ios-divider-thin);
}

.clarify-header {
  margin-bottom: var(--space-lg);
}

.clarify-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 600;
  background: var(--color-warning-bg);
  color: var(--color-warning);
  margin-bottom: var(--space-sm);
}

.clarify-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.clarify-summary {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.clarify-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.clarify-field {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.clarify-field-label {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 500;
}

.clarify-required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.clarify-input {
  height: 84rpx;
  padding: 0 var(--space-md);
  background: var(--color-bg-alt);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  color: var(--color-text-primary);
  box-sizing: border-box;
  border: 0.5rpx solid transparent;
  transition: border-color var(--duration-fast) var(--ease-smooth);
}

.clarify-input:focus {
  border-color: var(--color-primary);
  background: var(--color-card);
}

.clarify-placeholder {
  color: var(--color-text-placeholder);
}

.clarify-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.clarify-chip {
  min-height: 64rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0.5rpx solid transparent;
  transition: all var(--duration-fast) var(--ease-smooth);
}

.clarify-chip.is-active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border-color: rgba(47, 107, 79, 0.25);
  font-weight: 600;
}

.clarify-unit {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.clarify-actions {
  display: flex;
  flex-direction: row;
  gap: var(--space-sm);
  margin-top: var(--space-xl);
}

.clarify-btn {
  flex: 1;
  min-height: 88rpx;
  border-radius: var(--radius-lg);
  font-size: var(--font-md);
  font-weight: 600;
  border: 0;
}

.clarify-btn.primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.clarify-btn.secondary {
  background: var(--color-bg-alt);
  color: var(--color-text-primary);
}

.clarify-btn.ghost {
  background: transparent;
  color: var(--color-text-tertiary);
}

.clarify-btn::after { border: 0; }

@media (prefers-color-scheme: dark) {
  .clarify-card {
    background: var(--color-card);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .clarify-input {
    background: rgba(255, 255, 255, 0.05);
  }
  .clarify-input:focus {
    background: var(--color-card);
  }
  .clarify-chip {
    background: rgba(255, 255, 255, 0.06);
  }
  .clarify-btn.secondary {
    background: rgba(255, 255, 255, 0.08);
  }
}