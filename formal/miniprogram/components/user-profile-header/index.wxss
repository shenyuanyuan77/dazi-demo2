.profile-header {
  min-height: 178rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #1D1D1F;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 14rpx 38rpx rgba(31, 38, 46, .08), 0 2rpx 8rpx rgba(31, 38, 46, .035);
  box-sizing: border-box;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  color: #FFFFFF;
  background: linear-gradient(145deg, #576171, #242A32);
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 38, 46, .1);
  font-size: 31rpx;
  line-height: 94rpx;
  box-sizing: border-box;
}

.profile-avatar::after,
.sync-button::after,
.detail-button::after {
  border: 0;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  overflow: hidden;
  color: #1D1D1F;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-note,
.profile-goal {
  margin-top: 8rpx;
  color: #8A8F98;
  font-size: 20rpx;
}

.profile-goal {
  display: inline-flex;
  padding: 5rpx 12rpx;
  color: #4F6FAF;
  background: #EEF4FF;
  border-radius: 999rpx;
}

.profile-entry {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  margin: 0;
  color: #7C8490;
  background: #F3F5F8;
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 54rpx;
}

.profile-entry::after { border: 0; }
