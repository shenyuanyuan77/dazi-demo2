page { background: #F7F8FA; color: #17191D; }
.calendar-page { min-height: 100vh; padding: 0 28rpx 60rpx; box-sizing: border-box; }
.subnav { position: absolute; left: 28rpx; right: 28rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 34rpx; font-weight: 800; box-sizing: border-box; }
.subnav > text { position: absolute; left: 100rpx; right: 100rpx; text-align: center; }
.subnav button { margin: 0; padding: 0; background: transparent; }
.subnav button::after, .month-button::after { border: 0; }
.back-button { position: absolute; left: 0; width: 64rpx; height: 64rpx; font-size: 52rpx; font-weight: 300; }
.today-button { position: absolute; right: 168rpx; width: 88rpx; height: 56rpx; color: #2F6B4F; background: #EAF2FF !important; font-size: 23rpx; }
.calendar-card { margin-top: 0; padding: 28rpx 22rpx 30rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(31,38,46,.05); }
.month-head { height: 74rpx; display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 750; }
.month-button { width: 58rpx; height: 58rpx; color: #434A53; background: #F3F5F7; font-size: 40rpx; }
.weekdays, .days-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.weekdays { margin-top: 18rpx; color: #9298A1; text-align: center; font-size: 21rpx; }
.weekdays text { line-height: 56rpx; }
.days-grid { row-gap: 8rpx; }
.calendar-day { height: 72rpx; padding: 6rpx; box-sizing: border-box; }
.day-surface { position: relative; width: 100%; height: 100%; font-size: 25rpx; }
.record-dot { position: absolute; left: 50%; bottom: 5rpx; width: 7rpx; height: 7rpx; margin-left: -3.5rpx; background: #2F6B4F; border-radius: 50%; }
.calendar-day.selected .record-dot { background: #FFFFFF; }
.calendar-day.muted { color: #C4C8CE; }
.calendar-day.today .day-surface { color: #2F6B4F; background: #EEF5FF; }
.calendar-day.selected .day-surface { color: #fff; background: #2F6B4F; font-weight: 750; }
.day-detail { margin-top: 22rpx; padding: 26rpx; background: #FFFFFF; border: 1rpx solid #ECEFF3; }
.detail-head { display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 700; }
.detail-head text:last-child { color: #7C828A; font-size: 22rpx; font-weight: 400; }
.macro-row { margin-top: 22rpx; display: grid; grid-template-columns: repeat(4,1fr); gap: 8rpx; }
.macro-row view { padding: 16rpx 4rpx; display: flex; flex-direction: column; align-items: center; gap: 5rpx; background: #F6F8FB; border-radius: 16rpx; }
.macro-row text:first-child { font-size: 25rpx; font-weight: 700; }
.macro-row text:last-child { color: #8A9098; font-size: 18rpx; }
.detail-list { margin-top: 18rpx; }
.detail-section + .detail-section { margin-top: 16rpx; }
.detail-section-title { margin-bottom: 6rpx; font-size: 23rpx; font-weight: 700; }
.detail-row { min-height: 54rpx; display: flex; align-items: center; justify-content: space-between; color: #505760; border-top: 1rpx solid #F0F2F4; font-size: 22rpx; }
.training-detail > view { display: flex; flex-direction: column; gap: 4rpx; }
.training-detail > view text:first-child { color: #17191D; font-weight: 650; }
.training-detail > view text:last-child { color: #9298A1; font-size: 19rpx; }
.empty-detail { padding: 34rpx 0 10rpx; color: #9AA0A8; text-align: center; font-size: 22rpx; }
.confirm-date { width: 100%; height: 84rpx; margin: 22rpx 0 0; color: #FFFFFF; background: #2F6B4F; border: 0; font-size: 27rpx; font-weight: 700; line-height: 1; }
.confirm-date::after { border: 0; }
