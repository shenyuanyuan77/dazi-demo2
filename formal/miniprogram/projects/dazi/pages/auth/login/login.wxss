page { background: #F7F8FA; }
.login-page {
  min-height: 100vh;
  padding-left: 52rpx;
  padding-right: 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #17191D;
}
.brand-mark {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8ECF1;
  border-radius: 50%;
  box-shadow: 0 14rpx 38rpx rgba(31, 38, 46, .09);
}
.brand-star { position: absolute; background: #2888F7; clip-path: polygon(50% 0,61% 36%,100% 50%,61% 64%,50% 100%,39% 64%,0 50%,39% 36%); }
.star-main { left: 25rpx; top: 23rpx; width: 70rpx; height: 70rpx; }
.star-small { right: 20rpx; bottom: 22rpx; width: 38rpx; height: 38rpx; background: #8457D9; }
.login-title { margin-top: 42rpx; font-size: 44rpx; font-weight: 800; }
.login-copy { max-width: 580rpx; margin-top: 20rpx; color: #747B84; text-align: center; font-size: 27rpx; line-height: 1.7; }
.avatar-picker { width: 152rpx; height: 152rpx; margin-top: 48rpx; padding: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; color: #66707C; background: #FFFFFF; border: 1rpx solid #DDE3EA; border-radius: 50%; font-size: 22rpx; line-height: 1.3; }
.avatar-picker image { width: 100%; height: 100%; display: block; }
.avatar-picker::after { border: 0; }
.nickname-input { width: 100%; height: 88rpx; margin-top: 28rpx; padding: 0 26rpx; box-sizing: border-box; color: #17191D; background: #FFFFFF; border: 1rpx solid #DDE3EA; border-radius: 24rpx; font-size: 28rpx; text-align: center; }
.wechat-login { width: 100%; height: 92rpx; margin-top: 28rpx; color: #FFFFFF; background: #07C160; border: 0; font-size: 29rpx; font-weight: 700; line-height: 1; }
.wechat-login::after { border: 0; }
.privacy-note { margin-top: 22rpx; color: #A0A5AC; font-size: 21rpx; }
