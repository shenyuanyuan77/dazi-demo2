@import "../../../../../styles/design-tokens.wxss";

/* ====== ???? ====== */
page {
  background: var(--color-bg) !important;
  height: 100%;
  overflow: hidden;
}

/* ====== ???? ====== */
.skeleton-page { padding: 60rpx 32rpx; }
.skeleton {
  background: linear-gradient(90deg, #e8e9ec 25%, #f0f1f3 50%, #e8e9ec 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}
.skeleton-header {
  height: 80rpx;
  width: 60%;
  border-radius: var(--radius-lg);
  margin-bottom: 40rpx;
}
.skeleton-banner {
  height: 300rpx;
  border-radius: var(--radius-2xl);
  margin-bottom: 28rpx;
}
.skeleton-card {
  height: 360rpx;
  border-radius: var(--radius-2xl);
  margin-bottom: 20rpx;
}

/* ====== ?????????? ====== */
.glass-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255,255,255,0.82);
  -webkit-backdrop-filter: blur(32rpx) saturate(200%);
  backdrop-filter: blur(32rpx) saturate(200%);
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  padding-bottom: 12rpx;
}

.glass-nav-inner { padding: 0 24rpx; }

.nav-top { padding: 14rpx 0 10rpx; }

.nav-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.nav-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid rgba(47, 107, 79, 0.15);
  flex-shrink: 0;
}

.avatar-img { width: 100%; height: 100%; }

.nav-greeting {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.nav-username {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
}

/* AI ?????? */
.nav-ai-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx 8rpx 14rpx;
  background: rgba(47, 107, 79, 0.06);
  border: 1rpx solid rgba(47, 107, 79, 0.12);
  border-radius: var(--radius-full);
  flex-shrink: 0;
}
.nav-ai-btn:active { background: rgba(47, 107, 79, 0.12); }

.ai-badge {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(47, 107, 79, 0.2);
}

.ai-label {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: 500;
}

/* ====== ?????? ====== */
.nav-search { margin: 4rpx 0 10rpx; }

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 72rpx;
  border-radius: var(--radius-3xl);
  background: rgba(240,241,243,0.75);
  border: 1rpx solid var(--color-border);
}

.glass-light {
  background: rgba(244,245,247,0.8);
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.search-icon { font-size: var(--font-md); margin-right: 10rpx; flex-shrink: 0; }

.search-input {
  flex: 1;
  height: 100%;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  background: transparent;
}

.search-placeholder {
  color: var(--color-text-placeholder);
  font-size: var(--font-base);
}

/* ====== ?????????? ====== */
.cate-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 4rpx 0 8rpx;
}

.cate-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: rgba(0,0,0,0.03);
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
  transition: all var(--duration-fast) var(--ease-smooth);
  border: 1rpx solid transparent;
}

.cate-chip.active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-weight: 600;
  border-color: rgba(47, 107, 79, 0.15);
}

.cate-chip:active { transform: scale(0.94); }

/* ====== ?????? ====== */
.page-content {
  height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0 20rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));}

.page-has-glass-nav {
  padding-top: calc(220rpx + var(--status-bar-height, 44px));
}

.content-top-spacer { height: 16rpx; }

/* ====== Banner ?? ====== */
.banner-card {
  position: relative;
  height: 300rpx;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.banner-bg { position: absolute; inset: 0; }
.banner-img { width: 100%; height: 100%; }

.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(26,29,33,0.15) 0%, rgba(26,29,33,0.55) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28rpx;
}

.banner-title {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.banner-subtitle {
  font-size: var(--font-base);
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

/* ====== AI ?????????? ====== */
.ai-card {
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(47, 107, 79, 0.12);
}

.ai-card-head { cursor: pointer; }

.ai-card-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border-radius: var(--radius-lg);
  font-size: var(--font-md);
  font-weight: 700;
  flex-shrink: 0;
}

.ai-card-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.ai-card-subtitle {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}

.ai-card-toggle {
  padding: 6rpx 16rpx;
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.45);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: var(--radius-full);
}

.ai-card-body { margin-top: 18rpx; }

.ai-empty {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255,255,255,0.06);
  border-radius: var(--radius-lg);
  cursor: pointer;
}

.ai-empty-icon {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: var(--color-primary);
  background: rgba(47, 107, 79, 0.12);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.ai-empty-title { font-size: var(--font-base); font-weight: 600; color: #fff; }
.ai-empty-desc { font-size: var(--font-xs); color: rgba(255,255,255,0.45); margin-top: 4rpx; }
.ai-empty-arrow { color: var(--color-primary); font-size: var(--font-xl); margin-left: auto; flex-shrink: 0; }

.ai-results-scroll { width: 100%; overflow: hidden; }
.ai-results-row { display: flex; flex-wrap: nowrap; }

.ai-result-card {
  flex: 0 0 520rpx;
  padding: 20rpx;
  background: rgba(255,255,255,0.05);
  border-left: 6rpx solid var(--color-primary);
  border-radius: var(--radius-lg);
  white-space: normal;
  min-height: 200rpx;
}

.ai-result-card.training { border-left-color: var(--cate-strength); }

.ai-result-header { margin-bottom: 8rpx; }
.ai-result-type { font-size: var(--font-xs); color: var(--color-primary-light); font-weight: 500; }
.ai-result-card.training .ai-result-type { color: var(--cate-strength); }
.ai-result-refresh {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.35);
  font-size: var(--font-md);
}
.ai-result-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: #fff;
  margin-bottom: 10rpx;
}

.ai-diet-data { margin-bottom: 8rpx; }
.ai-calories text { font-size: var(--font-2xl); font-weight: 700; color: #fff; }
.ai-calories { font-size: var(--font-sm); color: rgba(255,255,255,0.55); }
.ai-macros { display: flex; gap: 16rpx; margin-top: 4rpx; }
.macro-item { font-size: var(--font-xs); color: rgba(255,255,255,0.45); }

.ai-training-preview {
  color: var(--cate-strength);
  font-size: var(--font-sm);
  margin-bottom: 8rpx;
}

.ai-result-summary {
  font-size: var(--font-xs);
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ai-result-link {
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--color-primary-light);
  font-weight: 500;
}

/* ====== ?????? ====== */
.activity-section { margin-top: 4rpx; }

/* ====== ?????? ====== */
.activity-card {
  margin-bottom: 20rpx;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  background: var(--color-card);
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-fast) var(--ease-smooth);
}

.activity-card:active { transform: scale(0.985); }

.card-cover-wrap {
  position: relative;
  height: 340rpx;
  overflow: hidden;
}

.card-cover { width: 100%; height: 100%; }

/* ?????????? -- ?????????? */
.card-cate-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.88);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--color-text-primary);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* ???? -- ?????????? */
.card-date-badge {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  padding: 8rpx 18rpx;
  background: rgba(0,0,0,0.4);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  color: #fff;
  font-weight: 500;
}

/* ?????? -- ???????????? */
.card-join-badge {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: rgba(47, 107, 79, 0.88);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(47, 107, 79, 0.2);
}

.join-count {
  font-size: var(--font-lg);
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}

.join-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.1;
}

/* ???? */
.card-body { padding: 20rpx 24rpx 24rpx; }

.card-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  margin-bottom: 14rpx;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card-publisher { font-size: var(--font-sm); }

.publisher-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(0,0,0,0.05);
}

.publisher-name { color: var(--color-text-secondary); }

.card-location,
.card-time {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.location-icon,
.time-icon { flex-shrink: 0; }

.location-text,
.time-text { color: var(--color-text-secondary); }

/* ====== ?????????????? ====== */
.float-publish-btn {
  position: fixed;
  right: 28rpx;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  z-index: 10000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  border-radius: 50%;
  box-shadow: 0 12rpx 40rpx rgba(47, 107, 79, 0.35), 0 0 0 4rpx rgba(255,255,255,0.3);
  gap: 2rpx;
  transition: transform var(--duration-fast) var(--ease-spring);
}

.publish-icon {
  font-size: 44rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.publish-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
  line-height: 1;
}

.float-publish-btn:active { transform: scale(0.9); }

/* ====== ?????? AI ??? ====== */
.float-ai-entry {
  position: fixed;
  right: 28rpx;
  bottom: calc(360rpx + env(safe-area-inset-bottom));
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: rgba(26,29,33,0.85);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(47, 107, 79, 0.25);
  border-radius: 50%;
  box-shadow: var(--shadow-lg);
}

.float-ai-badge {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-primary);
}

/* ====== ?????????? ====== */
.bottom-safe-spacer { height: calc(200rpx + env(safe-area-inset-bottom)); }

/* ====== ???? ====== */
@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ====== ?????????? ====== */
.page-container,
.main,
.main-content {
  background: transparent !important;
}

/* iOS HIG alignment */
.glass-nav {
  background: rgba(249, 249, 249, 0.94);
  border-bottom-color: rgba(60, 60, 67, 0.18);
}

.nav-action {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ios-blue);
  border-radius: 50%;
  font-size: 48rpx;
}

.nav-action:active { background: rgba(47, 107, 79, 0.1); transform: scale(.95); }
.nav-action-icon { line-height: 1; font-weight: 300; }

.page-content {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.ai-plan-card {
  min-height: 240rpx;
  max-height: 240rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--ios-secondary-bg);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: max-height 350ms cubic-bezier(.34, 1.2, .64, 1);
}

.ai-plan-card.expanded {
  max-height: 80vh;
}

.ai-plan-card.disabled { opacity: .72; }

.ai-card-head,
.ai-card-heading {
  display: flex;
  align-items: center;
}

.ai-card-head { justify-content: space-between; }

.ai-symbol,
.ai-empty-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ios-blue);
  background: rgba(47, 107, 79, 0.1);
  border-radius: 20rpx;
}

.ai-symbol {
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  font-size: 32rpx;
}

.ai-card-title {
  color: var(--color-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.ai-card-subtitle {
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.ai-more {
  min-width: 72rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ios-blue);
  font-size: 28rpx;
  letter-spacing: 3rpx;
  border-radius: 32rpx;
}

.ai-more:active { background: rgba(47, 107, 79, .1); }

.ai-loading {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.activity-indicator {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid var(--ios-gray-5);
  border-top-color: var(--ios-blue);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

.ai-empty {
  min-height: 122rpx;
  padding: 12rpx 0 0;
  background: transparent;
}

.ai-empty-symbol {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  flex: none;
}

.ai-empty-copy { flex: 1; min-width: 0; }
.ai-empty-title { color: var(--color-text-primary); font-size: 25rpx; font-weight: 600; }
.ai-empty-desc { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 21rpx; }

.ai-consult-button,
.ai-follow-button {
  margin: 0;
  color: #fff;
  background: var(--ios-blue);
  border-radius: 999rpx;
  font-weight: 600;
}

.ai-consult-button {
  min-width: 148rpx;
  height: 68rpx;
  padding: 0 22rpx;
  line-height: 68rpx;
  font-size: 24rpx;
}

.ai-consult-button::after,
.ai-follow-button::after { border: 0; }

.ai-consult-button:active,
.ai-follow-button:active { transform: scale(.95); opacity: .82; }

.segmented-control {
  margin-top: 24rpx;
  background: var(--ios-gray-5);
  border-radius: 16rpx;
}

.segmented-item {
  height: 56rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
}

.ai-results-scroll { margin-top: 20rpx; }
.ai-results-row { display: flex; gap: 16rpx; }

.ai-result-card {
  flex: 0 0 100%;
  min-height: 132rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  white-space: normal;
}

.ai-result-title {
  color: var(--color-text-primary);
  font-size: 27rpx;
  margin-bottom: 10rpx;
}

.ai-calories { color: var(--color-text-secondary); }
.ai-calories text { color: var(--color-text-primary); font-size: 38rpx; }
.ai-macros { gap: 18rpx; flex-wrap: wrap; }
.ai-macros text { color: var(--color-text-secondary); font-size: 22rpx; }

.ai-training-preview {
  color: var(--ios-blue);
  font-size: 25rpx;
}

.ai-result-summary {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.ai-result-summary.clamped {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.ai-follow-button {
  height: 82rpx;
  margin-top: 20rpx;
  line-height: 82rpx;
  font-size: 27rpx;
}

.float-ai-entry {
  right: 32rpx;
  bottom: auto;
  width: 112rpx;
  height: 112rpx;
  color: #fff;
  background: var(--ios-blue);
  border: 0;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 79, .28);
  transition: transform 200ms ease, top 200ms ease;
}

.float-ai-entry:active { transform: scale(.95); }

.float-ai-icon {
  position: relative;
  width: 48rpx;
  height: 38rpx;
  color: #fff;
  font-size: 52rpx;
  line-height: 30rpx;
  transform: rotate(-20deg);
}

.ai-unread-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 22rpx;
  height: 22rpx;
  background: var(--ios-red);
  border: 4rpx solid #fff;
  border-radius: 50%;
}

@media (prefers-color-scheme: dark) {
  page {
    --color-bg: #000;
    --color-bg-alt: #1C1C1E;
    --color-card: #1C1C1E;
    --color-card-alt: #2C2C2E;
    --color-border: #38383A;
    --color-divider: #38383A;
    --color-text-primary: #FFF;
    --color-text-secondary: #EBEBF5;
    --color-text-tertiary: #8E8E93;
    --ios-gray-5: #2C2C2E;
    --ios-secondary-bg: #1C1C1E;
  }

  .glass-nav { background: rgba(28, 28, 30, .94); }
  .search-bar { background: #2C2C2E; }
  .ai-unread-dot { border-color: #1C1C1E; }
}
