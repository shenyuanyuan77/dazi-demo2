page { background: #F7F8FA; color: #17191D; }
.subpage { min-height: 100vh; padding-left: 32rpx; padding-right: 32rpx; padding-bottom: 180rpx; box-sizing: border-box; }
.subnav { min-height: 116rpx; display: flex; align-items: flex-start; gap: 12rpx; }
.subnav button { width: 48rpx; height: 56rpx; margin: -4rpx 0 0 -10rpx; padding: 0; color: var(--color-text-primary); background: transparent; font-size: 52rpx; font-weight: 300; line-height: 52rpx; }
.subnav-title { font-size: 44rpx; font-weight: 800; line-height: 1.16; }
.subnav-subtitle { margin-top: 9rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.subnav button::after, .save-button::after { border: 0; }
.form-card { padding: 0 26rpx; overflow: hidden; background: var(--color-card); border: 1rpx solid var(--color-border); border-radius: 30rpx; }
.group-label { padding: 28rpx 4rpx 14rpx; color: var(--color-text-secondary); font-size: 23rpx; font-weight: 650; }
.avatar-field { width: 100%; height: 116rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: space-between; color: var(--color-text-primary); background: transparent; border-bottom: 1rpx solid var(--color-divider); font-size: 26rpx; font-weight: 400; line-height: 1; text-align: left; }
.avatar-field::after { border: 0; }
.avatar-value { display: flex; align-items: center; gap: 14rpx; color: var(--color-text-tertiary); font-size: 36rpx; }
.avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: linear-gradient(145deg, #576171 0%, #242A32 100%);
  overflow: hidden;
  border: 0;
  border-radius: 18rpx;
  box-sizing: border-box;
  box-shadow: none;
  font-size: 25rpx;
  font-weight: 700;
}
.avatar image { width: 100%; height: 100%; display: block; }
.field { height: 94rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #EEF0F2; font-size: 26rpx; box-sizing: border-box; }
.field:last-child { border-bottom: 0; }
.field input { width: 260rpx; height: 72rpx; line-height: 72rpx; text-align: right; font-size: 26rpx; }
.field > view { display: flex; align-items: center; gap: 10rpx; color: #8A9098; }
.field > view input { width: 150rpx; }
.value { color: #7C828A; }
.save-button { position: fixed; z-index: 50; left: 32rpx; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); width: auto; height: 88rpx; margin: 0; color: #fff; background: #34C759; border-radius: 28rpx; box-shadow: 0 12rpx 34rpx rgba(52,199,89,.2); font-size: 28rpx; font-weight: 700; line-height: 1; }
