page { background: #F7F8FA; color: #17191D; }
.subpage { min-height: 100vh; padding: 0 28rpx 60rpx; box-sizing: border-box; }
.subnav { position: absolute; left: 28rpx; right: 28rpx; height: 104rpx; display: flex; align-items: center; justify-content: space-between; font-size: 34rpx; font-weight: 800; }
.subnav button { width: 72rpx; margin: 0; padding: 0; color: #17191D; background: transparent; font-size: 52rpx; font-weight: 300; }
.subnav button::after, .save-button::after, .danger-button::after { border: 0; }
.nav-space { width: 72rpx; }
.card { margin-top: 22rpx; padding: 0 26rpx; background: #fff; border: 1rpx solid #ECEFF3; }
.option { min-height: 112rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #EEF0F2; }
.option:last-child { border-bottom: 0; }
.option > view { display: flex; flex-direction: column; gap: 7rpx; font-size: 27rpx; }
.option > text { color: #2F6B4F; font-size: 30rpx; font-weight: 700; }
.desc, .hint { color: #8A9098; font-size: 22rpx; }
.calorie-card { padding: 32rpx 28rpx; }
.calorie-input { margin-top: 24rpx; display: flex; align-items: baseline; gap: 12rpx; }
.calorie-input input { width: 240rpx; height: 76rpx; line-height: 76rpx; font-size: 54rpx; font-weight: 700; }
.calorie-input text { color: #8A9098; }
.privacy-card { padding: 30rpx; color: #666D76; font-size: 24rpx; line-height: 1.7; }
.card-title { margin-bottom: 14rpx; color: #17191D; font-size: 29rpx; font-weight: 700; }
.save-button, .danger-button { height: 88rpx; margin-top: 28rpx; font-size: 28rpx; font-weight: 700; line-height: 1; }
.save-button { color: #fff; background: #2F6B4F; }
.danger-button { color: #D64545; background: #FFF0F0; }
.auto-button {
  margin-top: 24rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #eef4ff;
  color: #1768e5;
  font-size: 26rpx;
  line-height: 72rpx;
}

.auto-button::after {
  border: 0;
}
