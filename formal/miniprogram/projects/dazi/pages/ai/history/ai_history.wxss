page {
  height: 100%;
  background: #F7F8FA;
  color: #17191D;
}

.page {
  height: 100vh;
  min-height: 100vh;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.history-page {
  display: flex;
  flex-direction: column;
  background: #F7F8FA;
}

.page-toolbar {
  min-height: 104rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.history-toolbar {
  position: relative;
  z-index: 3;
  margin-bottom: 20rpx;
}

.toolbar-copy {
  flex: 1;
  min-width: 0;
}

.page-title {
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #17191D;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #8A8F98;
  font-size: 21rpx;
  line-height: 1.5;
}

.back-button,
.new-button {
  margin: 0;
  padding: 0;
  flex: none;
}

.back-button::after,
.new-button::after,
.state-action::after {
  border: 0;
}

.back-button {
  width: 64rpx;
  height: 64rpx;
  color: #17191D;
  background: #FFFFFF;
  border: 1rpx solid #E0E5EB;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 38, 46, .06);
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
}

.new-button {
  width: 112rpx;
  height: 64rpx;
  color: #2F6B4F;
  background: #FFFFFF;
  border: 1rpx solid #E0E5EB;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 38, 46, .06);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1;
}

.search-card {
  height: 82rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECEFF3;
  box-shadow: 0 8rpx 24rpx rgba(31, 38, 46, .05);
  box-sizing: border-box;
}

.search-icon {
  flex: none;
  color: #8A8F98;
  font-size: 30rpx;
  line-height: 1;
}

.search-card input {
  flex: 1;
  height: 82rpx;
  min-height: 82rpx;
  color: #17191D;
  font-size: 26rpx;
  line-height: 82rpx;
}

.search-placeholder {
  color: #A0A5AC;
  font-size: 26rpx;
}

.session-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 22rpx;
}

.session-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.session-card,
.state-card {
  background: #FFFFFF;
  border: 1rpx solid #ECEFF3;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 38, 46, .05);
  box-sizing: border-box;
}

.session-card {
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.session-card:active {
  opacity: .78;
  transform: scale(.992);
  transition: opacity .08s ease, transform .08s ease;
}

.session-icon {
  width: 66rpx;
  height: 66rpx;
  flex: none;
  color: #FFFFFF;
  background: #2F6B4F;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(47, 107, 79, .18);
}

.session-copy {
  flex: 1;
  min-width: 0;
}

.session-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #17191D;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.session-type {
  margin-top: 7rpx;
  color: #8A8F98;
  font-size: 21rpx;
  line-height: 1.45;
}

.session-meta {
  flex: none;
  min-width: 74rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  color: #A0A5AC;
  font-size: 20rpx;
}

.chevron {
  color: #C4C8CE;
  font-size: 34rpx;
  line-height: 1;
}

.state-card {
  margin-top: 22rpx;
  padding: 90rpx 30rpx;
  color: #8A8F98;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #17191D;
  font-size: 30rpx;
  font-weight: 700;
}

.state-action {
  width: 220rpx;
  height: 64rpx;
  margin: 22rpx auto 0;
  color: #2F6B4F;
  background: #EEF5FF;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
}

.list-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
  flex: none;
}

@media (prefers-color-scheme: dark) {
  page,
  .history-page {
    background: #111214;
    color: #F5F5F7;
  }

  .page-title,
  .session-title,
  .empty-title {
    color: #F5F5F7;
  }

  .page-subtitle,
  .session-type,
  .session-meta,
  .search-placeholder {
    color: #8E8E93;
  }

  .back-button,
  .new-button,
  .search-card,
  .session-card,
  .state-card {
    background: #1C1C1E;
    border-color: rgba(255, 255, 255, .08);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .22);
  }

  .search-card input {
    color: #F5F5F7;
  }
}
